# Django
DJANGO_SECRET_KEY=your-django-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,YOUR_SERVER_IP,yourdomain.com

# Database (Optional - uses SQLite by default)
DATABASE_URL=postgresql://user:password@host:5432/db

# API Keys (Required)
OPENAI_API_KEY=your-openai-api-key
COMPOSIO_API_KEY=your-composio-api-key

# OAuth Credentials (Required for Social Login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# CORS / CSRF (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://yourdomain.com

# EmailJS Configuration (for email verification)
EMAILJS_SERVICE_ID=your-emailjs-service-id
EMAILJS_TEMPLATE_ID=your-emailjs-template-id
EMAILJS_PASSWORD_RESET_TEMPLATE_ID=your-emailjs-password-reset-template-id
EMAILJS_PUBLIC_KEY=your-emailjs-public-key
EMAILJS_PRIVATE_KEY=your-emailjs-private-key

# Frontend URL (for email verification redirects)
FRONTEND_URL=http://localhost:3000

# Admin URL (change this to something secure and random)
ADMIN_URL=your-random-admin-path/

# Agent Tools APIs
YOUTUBE_API_KEY=your-youtube-api-key
SERPAPI_KEY=your-serpapi-key
