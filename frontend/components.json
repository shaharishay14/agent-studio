{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/index.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "registries": {
    "@react-bits": "https://registry.react-bits.dev/r/{name}.json",
    "@21st": {
      "url": "https://21st.dev/r/{name}",
      "headers": {
        "Authorization": "Bearer ${TWENTY_FIRST_API_KEY}"
      }
    }
  },
  "iconLibrary": "lucide"
}
